	"notes": {
		"Jeu/Sessions du Masque/Joueurs/Arek.md#Attributs": {
			"html": "<div class=\"markdown-rendered\"><h2 data-heading=\"Attributs\" dir=\"auto\">Attributs</h2>\n<h3 data-heading=\"Combat\" dir=\"auto\">Combat</h3>\n<blockquote dir=\"auto\">\n<p>55 points à mettre au niveau 1 (min 7, max 14)<br>\n+1 points par niveau sauf les niveaux 1, 5, 10, 15 et 20</p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th align=\"center\">Force</th>\n<th align=\"center\">Dextérité</th>\n<th align=\"center\">Mental</th>\n<th align=\"center\">Perception</th>\n<th align=\"center\">Charisme</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\">19</td>\n<td align=\"center\">10</td>\n<td align=\"center\">18</td>\n<td align=\"center\">10</td>\n<td align=\"center\">8</td>\n</tr>\n<tr>\n<td align=\"center\">+4</td>\n<td align=\"center\">0</td>\n<td align=\"center\">+4</td>\n<td align=\"center\">0</td>\n<td align=\"center\">-1</td>\n</tr>\n</tbody>\n</table>\n<h3 data-heading=\"Magie\" dir=\"auto\">Magie</h3>\n<blockquote dir=\"auto\">\n<p><strong>Maîtrise</strong> : 1<br>\n<strong>Crystaux</strong> : 9</p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th align=\"center\">Air</th>\n<th align=\"center\">Eau</th>\n<th align=\"center\">Roche</th>\n<th align=\"center\">Feu</th>\n<th align=\"center\">Foudre</th>\n<th align=\"center\">Lumière</th>\n<th align=\"center\">Ténèbres</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\">-</td>\n<td align=\"center\">-</td>\n<td align=\"center\">7</td>\n<td align=\"center\">4</td>\n<td align=\"center\">-</td>\n<td align=\"center\">9</td>\n<td align=\"center\">-</td>\n</tr>\n<tr>\n<td align=\"center\">-</td>\n<td align=\"center\">-</td>\n<td align=\"center\">1d6</td>\n<td align=\"center\">1d4</td>\n<td align=\"center\">-</td>\n<td align=\"center\">1d8 +5</td>\n<td align=\"center\">-</td>\n</tr>\n</tbody>\n</table></div>"
		},
		"Jeu/Sessions du Masque/Joueurs/Arek.md#Equipement": {
			"html": "<div class=\"markdown-rendered\"><h2 data-heading=\"Equipement\" dir=\"auto\">Equipement</h2>\n<h3 data-heading=\"[[Armes]]\" dir=\"auto\"><a data-href=\"Armes\" href=\"/Jeu/Regles/Combat/Armes/\" class=\"internal-link\" rel=\"noopener nofollow\">Armes</a></h3>\n<table>\n<thead>\n<tr>\n<th align=\"center\">Court</th>\n<th align=\"center\">1 Main</th>\n<th align=\"center\">2 Mains</th>\n<th align=\"center\">Haste</th>\n<th align=\"center\">Distance</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\">7</td>\n<td align=\"center\">8</td>\n<td align=\"center\">0</td>\n<td align=\"center\">0</td>\n<td align=\"center\">0</td>\n</tr>\n<tr>\n<td align=\"center\">+3</td>\n<td align=\"center\">+4</td>\n<td align=\"center\">0</td>\n<td align=\"center\">0</td>\n<td align=\"center\">0</td>\n</tr>\n</tbody>\n</table>\n<table>\n<thead>\n<tr>\n<th>Arme</th>\n<th>Dégâts</th>\n<th align=\"center\">Poids (kg)</th>\n<th align=\"center\">Propriétés</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Hache<br>Orichalque<br>1 Main<br>(lourd)<br></td>\n<td>(1d8+8Force(Monk))<br>+36 +10Nirina<br>VS Démons<br>Ténèbres 4<br>= 41-48</td>\n<td align=\"center\">7.5</td>\n<td align=\"center\">Force &gt; 15</td>\n</tr>\n<tr>\n<td>Hache <br>Orichalque<br>1 Main<br>(lourd)</td>\n<td>(1d8+8Force(Monk))<br>+36 +2Nirina<br>VS Démons<br>Ténèbres 4<br>= 41-48</td>\n<td align=\"center\">7.5</td>\n<td align=\"center\">Force &gt; 15</td>\n</tr>\n<tr>\n<td>Epée<br>Palladium<br>1 Main<br>(lourd)</td>\n<td>(1d8+8Force(Monk))<br>+30 +3Nirina<br>VS Anges<br>Ténèbres 4<br>= 35-42</td>\n<td align=\"center\">6</td>\n<td align=\"center\">Force &gt; 15<br>Sang de dieu : <a data-tooltip-position=\"top\" aria-label=\"Propriétés &gt; Lacération\" data-href=\"Propriétés#Lacération\" href=\"/Jeu/Regles/Statuts/Proprietes/#lacration\" class=\"internal-link\" rel=\"noopener nofollow\">Lacération</a></td>\n</tr>\n</tbody>\n</table>\n<h3 data-heading=\"[[Armures]]\" dir=\"auto\"><a data-href=\"Armures\" href=\"/Jeu/Regles/Combat/Armures/\" class=\"internal-link\" rel=\"noopener nofollow\">Armures</a></h3>\n<table>\n<thead>\n<tr>\n<th>Armure</th>\n<th align=\"center\">AC</th>\n<th align=\"center\">DR</th>\n<th align=\"center\">Enchantement</th>\n<th align=\"center\">Poids (kg)</th>\n<th align=\"center\">Dégâts</th>\n<th align=\"center\">Propriétés</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Armure<br>Paladium<br>Enchant Nirina 6 + 3</td>\n<td align=\"center\">5</td>\n<td align=\"center\">35<br>+16(Impénétrable)<br>+ 6+3 Nirina<br>= 60</td>\n<td align=\"center\"></td>\n<td align=\"center\">36</td>\n<td align=\"center\">-</td>\n<td align=\"center\">Dextérité(Discrétion) impossible<br><br>Magies impossibles en combat</td>\n</tr>\n<tr>\n<td>Cape Fourrure</td>\n<td align=\"center\">-</td>\n<td align=\"center\">-</td>\n<td align=\"center\">Feu 5<br>Foudre 1</td>\n<td align=\"center\">2</td>\n<td align=\"center\">-</td>\n<td align=\"center\">Fusion = 1 crystal gratuit par action</td>\n</tr>\n<tr>\n<td>Bouclier d'Estoc</td>\n<td align=\"center\">-3</td>\n<td align=\"center\">30 (Orichalque 75%)<br>+4Nirina<br>= 34</td>\n<td align=\"center\">Foudre 5</td>\n<td align=\"center\">12</td>\n<td align=\"center\">1d4 +4</td>\n<td align=\"center\"><a data-tooltip-position=\"top\" aria-label=\"Propriétés &gt; Charge\" data-href=\"Propriétés#Charge\" href=\"/Jeu/Regles/Statuts/Proprietes/#charge\" class=\"internal-link\" rel=\"noopener nofollow\">Charge</a></td>\n</tr>\n<tr>\n<td>Armure<br>Os Gammoth</td>\n<td align=\"center\">8</td>\n<td align=\"center\">20(Os rare)<br>+16(Impénétrable)<br>= 36</td>\n<td align=\"center\">Glace 4</td>\n<td align=\"center\">18</td>\n<td align=\"center\">-</td>\n<td align=\"center\">Désavantage en Dextérité (Discrétion)<br><br> Désavantage en Magies en combat<br> <br> 1 invulnérabilité magique</td>\n</tr>\n</tbody>\n</table></div>"
		},

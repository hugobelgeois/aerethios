	"notes": {
		"Jeu/Sessions du Masque/Joueurs/Hazdaim.md#Attributs": {
			"html": "<div class=\"markdown-rendered\"><h2 data-heading=\"Attributs\" dir=\"auto\">Attributs</h2>\n<h3 data-heading=\"Combat\" dir=\"auto\">Combat</h3>\n<blockquote dir=\"auto\">\n<p>55 points à mettre au niveau 1 (min 7, max 14)<br>\n+1 points par niveau sauf les niveaux 1, 5, 10, 15 et 20</p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th align=\"center\">Force</th>\n<th align=\"center\">Dextérité</th>\n<th align=\"center\">Mental</th>\n<th align=\"center\">Perception</th>\n<th align=\"center\">Charisme</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\">10</td>\n<td align=\"center\">15</td>\n<td align=\"center\">10</td>\n<td align=\"center\">12</td>\n<td align=\"center\">15</td>\n</tr>\n<tr>\n<td align=\"center\">0</td>\n<td align=\"center\">+2</td>\n<td align=\"center\">0</td>\n<td align=\"center\">+1</td>\n<td align=\"center\">+2</td>\n</tr>\n</tbody>\n</table>\n<h3 data-heading=\"Magie\" dir=\"auto\">Magie</h3>\n<blockquote dir=\"auto\">\n<p><strong>Maîtrise</strong> : 1<br>\n<strong>Crystaux</strong> : 9</p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th align=\"center\">Air</th>\n<th align=\"center\">Eau</th>\n<th align=\"center\">Roche</th>\n<th align=\"center\">Feu</th>\n<th align=\"center\">Foudre</th>\n<th align=\"center\">Lumière</th>\n<th align=\"center\">Ténèbres</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\">1</td>\n<td align=\"center\">-</td>\n<td align=\"center\">-</td>\n<td align=\"center\">-</td>\n<td align=\"center\">8</td>\n<td align=\"center\">6</td>\n<td align=\"center\">1</td>\n</tr>\n<tr>\n<td align=\"center\">1d4</td>\n<td align=\"center\">-</td>\n<td align=\"center\">-</td>\n<td align=\"center\">-</td>\n<td align=\"center\">1d6</td>\n<td align=\"center\">1d6</td>\n<td align=\"center\">1d4</td>\n</tr>\n</tbody>\n</table></div>"
		},
		"Jeu/Sessions du Masque/Joueurs/Hazdaim.md#Equipement": {
			"html": "<div class=\"markdown-rendered\"><h2 data-heading=\"Equipement\" dir=\"auto\">Equipement</h2>\n<h3 data-heading=\"[[Armes]]\" dir=\"auto\"><a data-href=\"Armes\" href=\"/Jeu/Regles/Combat/Armes/\" class=\"internal-link\" rel=\"noopener nofollow\">Armes</a></h3>\n<table>\n<thead>\n<tr>\n<th align=\"center\">Court</th>\n<th align=\"center\">1 Main</th>\n<th align=\"center\">2 Mains</th>\n<th align=\"center\">Haste</th>\n<th align=\"center\">Distance</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\">2</td>\n<td align=\"center\">8</td>\n<td align=\"center\">0</td>\n<td align=\"center\">0</td>\n<td align=\"center\">2 (1xp)</td>\n</tr>\n<tr>\n<td align=\"center\">+1</td>\n<td align=\"center\">+4</td>\n<td align=\"center\">0</td>\n<td align=\"center\">0</td>\n<td align=\"center\">+1</td>\n</tr>\n</tbody>\n</table>\n<table>\n<thead>\n<tr>\n<th>Arme</th>\n<th>Dégâts</th>\n<th align=\"center\">Poids (kg)</th>\n<th align=\"center\">Propriétés</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Lame Revers<br>Orichalque<br>1 Main<br>(léger)</td>\n<td>(3d8+4Dex(Ranger))<br>+12 +3Nirina<br>VS Démons<br>Ténèbres 3<br>= 22-43</td>\n<td align=\"center\">2.5</td>\n<td align=\"center\">-</td>\n</tr>\n<tr>\n<td>Lame Revers<br>Palladium<br>1 Main<br>(léger)</td>\n<td>(3d8+4Dex(Ranger))<br>+10 +6Nirina<br>VS Anges<br>Ténèbres 3<br>= 23-44</td>\n<td align=\"center\">2</td>\n<td align=\"center\">-</td>\n</tr>\n<tr>\n<td>Arbalète Sharah<br>Adamantite (Or)<br>Distance<br>(léger)</td>\n<td>(3d8+4Dex(Ranger))<br>+10<br>Crit 3<br>VS Mythiques<br>Air<br>= 15-36</td>\n<td align=\"center\">2</td>\n<td align=\"center\"><a data-tooltip-position=\"top\" aria-label=\"Propriétés &gt; Léger\" data-href=\"Propriétés#Léger\" href=\"/Jeu/Regles/Statuts/Proprietes/#lger\" class=\"internal-link\" rel=\"noopener nofollow\">Léger</a></td>\n</tr>\n<tr>\n<td>Lame Revers<br>Titane<br>1 Main</td>\n<td>2d8<br>+14<br>Crit 2<br>VS Invocations<br>= 16-30</td>\n<td align=\"center\">3</td>\n<td align=\"center\">-</td>\n</tr>\n<tr>\n<td>Lame Revers<br>Titane<br>1 Main</td>\n<td>2d8<br>+14<br>Crit 2<br>VS Invocations<br>= 16-30</td>\n<td align=\"center\">3</td>\n<td align=\"center\">-</td>\n</tr>\n</tbody>\n</table>\n<h3 data-heading=\"[[Armures]]\" dir=\"auto\"><a data-href=\"Armures\" href=\"/Jeu/Regles/Combat/Armures/\" class=\"internal-link\" rel=\"noopener nofollow\">Armures</a></h3>\n<table>\n<thead>\n<tr>\n<th>Armure</th>\n<th align=\"center\">AC</th>\n<th align=\"center\">DR</th>\n<th align=\"center\">Enchantement</th>\n<th align=\"center\">Poids (kg)</th>\n<th align=\"center\">Dégâts</th>\n<th align=\"center\">Propriétés</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Armure Cuir</td>\n<td align=\"center\">12<br>+2(Dex)<br>= 14</td>\n<td align=\"center\">9(peu commun)<br>+3(Impé) = 12</td>\n<td align=\"center\">Roche 2<br>Feu 2</td>\n<td align=\"center\">12</td>\n<td align=\"center\">-</td>\n<td align=\"center\">Résiste à <a data-tooltip-position=\"top\" aria-label=\"Conditions &gt; Poison\" data-href=\"Conditions#Poison\" href=\"/Jeu/Regles/Statuts/Conditions/#poison\" class=\"internal-link\" rel=\"noopener nofollow\">Poison</a></td>\n</tr>\n<tr>\n<td>Cape Fourrure</td>\n<td align=\"center\">-</td>\n<td align=\"center\">-</td>\n<td align=\"center\">Ténèbres 5</td>\n<td align=\"center\">1</td>\n<td align=\"center\">-</td>\n<td align=\"center\">Les sorts croitistes à 1 crystal ne le consomme pas</td>\n</tr>\n</tbody>\n</table></div>"
		},
